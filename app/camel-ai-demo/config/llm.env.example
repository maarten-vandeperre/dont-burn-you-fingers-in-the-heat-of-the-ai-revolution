# Central configuration of every model provider. Copy to config/llm.env (git-ignored) and fill in.
# run.sh loads this file; routes/application.properties maps it onto Camel properties.
# Leave a key empty to disable that provider (calls to it then return an error).

# --- Qwen on Podman Desktop AI Lab (local, OpenAI compatible) ---------------------------
# Podman Desktop > AI Lab > Services > your Qwen model service: copy the port it shows.
QWEN_BASE_URL=http://localhost:35000/v1
QWEN_MODEL=qwen
QWEN_API_KEY=not-needed

# --- OpenAI -------------------------------------------------------------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ----------------------------------------------------------------------------
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Behaviour ----------------------------------------------------------------------------
# provider used when the local model is down or too slow (alias "auto"): openai | anthropic
LLM_FALLBACK=anthropic
# give the local model this long before falling back (ms)
LLM_LOCAL_TIMEOUT_MS=60000
LLM_MAX_TOKENS=512
# provider for the file routes: auto | qwen | openai | anthropic
FILES_PROVIDER=auto
