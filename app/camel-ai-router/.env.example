# camel-ai-router configuration. Copy to .env (git-ignored): podman compose reads it automatically.
# A provider is "configured" exactly when the variables below are non-empty. None are required
# to start the app, but at least OPENAI_API_KEY or LOCAL_BASE_URL must be set for the default
# ("auto") routing to work; otherwise every request without an explicit "provider" is rejected.

# --- OpenAI (online, the default when configured) ----------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com

# --- Anthropic (online, only used when explicitly steered to: ?provider=anthropic) --------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=1024

# --- vLLM "online" through OpenShift AI Models-as-a-Service (?provider=vllm) --------------
# https://maas.<apps-domain>/<namespace>/<model>  (OpenShift AI > Gen AI Studio > API keys)
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=
# true only for lab clusters with a self-signed ingress certificate
VLLM_TRUST_ALL=false

# --- local model: the fallback target, and the default when OpenAI is not configured ------
# Any OpenAI-compatible server. Podman Desktop > AI Lab > Services > your model service: use its
# port. From inside a container the laptop is host.containers.internal, not localhost.
LOCAL_BASE_URL=http://host.containers.internal:35000
LOCAL_API_KEY=
LOCAL_MODEL=

# --- circuit breaker + fallback policy, per online provider --------------------------------
# x failures within y minutes -> force every request to the local model for the next z minutes,
# without even attempting the online provider (needs a configured local model). Independent of
# this, ANY single failure of an online provider already falls back to local for that request
# alone (Camel circuitBreaker().onFallback()), when local is configured.
BREAKER_FAILURE_THRESHOLD=5   # x
BREAKER_WINDOW_MINUTES=2      # y
BREAKER_OPEN_MINUTES=5        # z
BREAKER_TIMEOUT_MS=60000
