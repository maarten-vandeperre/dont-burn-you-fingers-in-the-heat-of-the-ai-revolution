# Central configuration. Copy to .env (git-ignored): podman compose reads it automatically.
# Both providers run side by side; the UI picks one per message (or sends to both).
# A provider without configuration simply answers with an error in the UI.

# --- Qwen on Podman Desktop AI Lab (local) ------------------------------------------------
# Podman Desktop > AI Lab > Services > your Qwen service: use its port. From inside a
# container the laptop is host.containers.internal (not localhost).
QWEN_BASE_URL=http://host.containers.internal:35000/v1
QWEN_MODEL=qwen
QWEN_API_KEY=not-needed

# --- OpenAI ------------------------------------------------------------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- The app ------------------------------------------------------------------------------
# provider selected when the page opens: qwen | openai
DEFAULT_PROVIDER=openai
SHOP_TIMEZONE=Europe/Brussels
# NeMo Guardrails server image: the TrustyAI build (same as OpenShift AI) by default
GUARDRAILS_IMAGE=quay.io/trustyai/nemo-guardrails-server:latest
